@model IEnumerable<StayFinder.Models.Reservation>

@{
    Layout = null;
    ViewData["Title"] = "My Reservations";
    var currentRole = Context.Session.GetString("Role");
}

<!DOCTYPE html>
<html lang="zxx" class="no-js">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>My Reservations - StayFinder</title>
    <link rel="shortcut icon" href="~/img/fav.png">
    <link href="https://fonts.googleapis.com/css?family=Poppins:100,200,400,300,500,600,700" rel="stylesheet">
    <link rel="stylesheet" href="~/css/linearicons.css">
    <link rel="stylesheet" href="~/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/css/bootstrap.css">
    <link rel="stylesheet" href="~/css/animate.min.css">
    <link rel="stylesheet" href="~/css/owl.carousel.css">
    <link rel="stylesheet" href="~/css/main.css">
</head>
<body>
    <header id="header">
        <div class="header-top">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6 col-sm-6 col-6 header-top-left">
                        <ul>
                            <li><span style="color:white;">@currentRole</span></li>
                            <li>
                                <form method="post" action="/Account/Logout" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" style="background:none;border:none;color:white;cursor:pointer;padding:0;">Sign out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="container main-menu">
            <div class="row align-items-center justify-content-between d-flex">
                <div id="logo">
                    <a href="/" style="font-size:24px;font-weight:700;color:#fff;text-decoration:none;">StayFinder</a>
                </div>
                <nav id="nav-menu-container">
                    <ul class="nav-menu">
                        <li><a href="/">Home</a></li>
                        <li><a href="/Accommodation">Accommodations</a></li>
                        @if (string.Equals(currentRole, "Guest", StringComparison.OrdinalIgnoreCase))
                        {
                            <li><a href="/Reservation/MyReservations">My Reservations</a></li>
                        }
                        @if (string.Equals(currentRole, "Owner", StringComparison.OrdinalIgnoreCase))
                        {
                            <li><a href="/Owner/Dashboard">Dashboard</a></li>
                            <li><a href="/Accommodation/MyAccommodations">My Accommodations</a></li>
                        }
                        <li><a href="/Home/Privacy">Privacy</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </header>

    <section class="about-banner relative">
        <div class="overlay overlay-bg"></div>
        <div class="container">
            <div class="row d-flex align-items-center justify-content-center">
                <div class="about-content col-lg-12">
                    <h1 class="text-white">My Reservations</h1>
                </div>
            </div>
        </div>
    </section>

    <section class="section-gap">
        <div class="container">

            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success">@TempData["Message"]</div>
            }

            @if (!Model.Any())
            {
                <div class="alert alert-info">Nemate nijednu rezervaciju.</div>
                <a href="/Accommodation" class="primary-btn text-uppercase">Browse accommodations</a>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Accommodation</th>
                                <th>Date from</th>
                                <th>Date to</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reservation in Model)
                            {
                                <tr>
                                    <td><a href="/Accommodation/Details/@reservation.AccommodationId">@reservation.AccommodationId</a></td>
                                    <td>@reservation.DateFrom.ToString("dd.MM.yyyy")</td>
                                    <td>@reservation.DateTo.ToString("dd.MM.yyyy")</td>
                                    <td>$@reservation.TotalPrice</td>
                                    <td>
                                        @{
                                            var badgeClass = reservation.Status switch
                                            {
                                                "Confirmed" => "badge badge-success",
                                                "Cancelled" => "badge badge-danger",
                                                _ => "badge badge-warning"
                                            };
                                        }
                                        <span class="@badgeClass">@reservation.Status</span>
                                    </td>
                                    <td>
                                        <form asp-controller="Reservation" asp-action="Delete" method="post" style="display:inline;"
                                              onsubmit="return confirm('Otkazati ovu rezervaciju?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@reservation.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </section>

    <script src="~/js/vendor/jquery-2.2.4.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/vendor/bootstrap.min.js"></script>
    <script src="~/js/main.js"></script>
</body>
</html>
