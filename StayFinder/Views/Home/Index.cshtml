@{
    Layout = null;
    ViewData["Title"] = "Home Page";

    var currentUserId = Context.Session.GetString("UserId");
    var currentRole = Context.Session.GetString("Role");
}

<!DOCTYPE html>
<html lang="zxx" class="no-js">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta charset="UTF-8">
    <title>Travel</title>

    <link rel="shortcut icon" href="~/img/fav.png">
    <link href="https://fonts.googleapis.com/css?family=Poppins:100,200,400,300,500,600,700" rel="stylesheet">
    <link rel="stylesheet" href="~/css/linearicons.css">
    <link rel="stylesheet" href="~/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/css/bootstrap.css">
    <link rel="stylesheet" href="~/css/magnific-popup.css">
    <link rel="stylesheet" href="~/css/jquery-ui.css">
    <link rel="stylesheet" href="~/css/nice-select.css">
    <link rel="stylesheet" href="~/css/animate.min.css">
    <link rel="stylesheet" href="~/css/owl.carousel.css">
    <link rel="stylesheet" href="~/css/main.css">
</head>
<body>
    <header id="header">
        <div class="header-top">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6 col-sm-6 col-6 header-top-left">
                        <ul>
                            @if (string.IsNullOrWhiteSpace(currentUserId))
                            {
                                <li><a href="/Account/Login">Log in</a></li>
                                <li><a href="/Account/Register">Sign up</a></li>
                            }
                            else
                            {
                                <li><span style="color:white;">@currentRole</span></li>
                                @if (string.Equals(currentRole, "Owner", StringComparison.OrdinalIgnoreCase))
                                {
                                    <li><a href="/Owner/Dashboard">Dashboard</a></li>
                                }
                                else
                                {
                                    <li><a href="/Reservation/MyReservations">My Reservations</a></li>
                                }
                                <li>
                                    <form method="post" action="/Account/Logout" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" style="background:none;border:none;color:white;cursor:pointer;padding:0;">Sign out</button>
                                    </form>
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="col-lg-6 col-sm-6 col-6 header-top-right">
                        <div class="header-social">
                            <a href="#"><i class="fa fa-facebook"></i></a>
                            <a href="#"><i class="fa fa-twitter"></i></a>
                            <a href="#"><i class="fa fa-dribbble"></i></a>
                            <a href="#"><i class="fa fa-behance"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="container main-menu">
            <div class="row align-items-center justify-content-between d-flex">
                <div id="logo">
                    <a href="/"><img src="~/img/logo.png" alt="" title="" /></a>
                </div>
                <nav id="nav-menu-container">
                    <ul class="nav-menu">
                        <li><a href="/">Home</a></li>
                        <li><a href="/Accommodation">Accomodations</a></li>
                        @if (string.Equals(currentRole, "Guest", StringComparison.OrdinalIgnoreCase))
                        {
                            <li><a href="/Reservation/MyReservations">My Reservations</a></li>
                        }
                        @if (string.Equals(currentRole, "Owner", StringComparison.OrdinalIgnoreCase))
                        {
                            <li><a href="/Owner/Dashboard">Dashboard</a></li>
                            <li><a href="/Accommodation/MyAccommodations">My Accommodations</a></li>
                        }
                        <li><a href="/Home/Privacy">Privacy</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </header>

    <section class="banner-area relative">
        <div class="overlay overlay-bg"></div>
        <div class="container">
            <div class="row fullscreen align-items-center justify-content-between">
                <div class="col-lg-6 col-md-6 banner-left">
                    <h6 class="text-white">Away from monotonous life</h6>
                    <h1 class="text-white">Magical Travel</h1>
                    <p class="text-white">
                        StayFinder - pronadji smestaj brzo i lako.
                    </p>
                    <a href="/Accommodation" class="primary-btn text-uppercase">Get Started</a>
                </div>
                <div class="col-lg-4 col-md-6 banner-right">
                    <ul class="nav nav-tabs justify-content-center" id="myTab" role="tablist">
                        <li class="nav-item w-100 text-center">
                            <a class="nav-link active" id="hotel-tab" data-toggle="tab" href="#hotel" role="tab" aria-controls="hotel" aria-selected="true">Search your next destination!</a>
                        </li>
                    </ul>
                    <div class="tab-content" id="myTabContent">
                        <div class="tab-pane fade show active" id="hotel" role="tabpanel" aria-labelledby="hotel-tab">
                            <form class="form-wrap" method="get" action="/Accommodation">
                                <input type="text" class="form-control" name="location" placeholder="Where?">
                                <input type="text" class="form-control date-picker" name="start" placeholder="Start">
                                <input type="text" class="form-control date-picker" name="end" placeholder="Return">
                                <button type="submit" class="primary-btn text-uppercase w-100">Search Hotels</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script src="~/js/vendor/jquery-2.2.4.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/vendor/bootstrap.min.js"></script>
    <script src="~/js/jquery-ui.js"></script>
    <script src="~/js/easing.min.js"></script>
    <script src="~/js/hoverIntent.js"></script>
    <script src="~/js/superfish.min.js"></script>
    <script src="~/js/jquery.ajaxchimp.min.js"></script>
    <script src="~/js/jquery.magnific-popup.min.js"></script>
    <script src="~/js/jquery.nice-select.min.js"></script>
    <script src="~/js/owl.carousel.min.js"></script>
    <script src="~/js/main.js"></script>
</body>
</html>