@model IEnumerable<StayFinder.Models.Accommodation>

@{
    Layout = null;
    ViewData["Title"] = "My Accommodations";
    var currentRole = Context.Session.GetString("Role");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>My Accommodations</title>
    <link href="https://fonts.googleapis.com/css?family=Poppins:100,200,400,300,500,600,700" rel="stylesheet">
    <link rel="stylesheet" href="~/css/linearicons.css">
    <link rel="stylesheet" href="~/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/css/bootstrap.css">
    <link rel="stylesheet" href="~/css/main.css">
</head>
<body>
    <header id="header">
        <div class="header-top">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6 col-sm-6 col-6 header-top-left">
                        <ul>
                            <li><span style="color:white;">@currentRole</span></li>
                            <li>
                                <form method="post" action="/Account/Logout" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" style="background:none;border:none;color:white;cursor:pointer;padding:0;">Sign out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="container main-menu">
            <div class="row align-items-center justify-content-between d-flex">
                <div id="logo">
                    <a href="/" style="font-size:24px;font-weight:700;color:#fff;text-decoration:none;">StayFinder</a>
                </div>
                <nav id="nav-menu-container">
                    <ul class="nav-menu">
                        <li><a href="/">Home</a></li>
                        <li><a href="/Accommodation">Hotels</a></li>
                        <li><a href="/Owner/Dashboard">Dashboard</a></li>
                        <li><a href="/Accommodation/MyAccommodations"><strong>My Accommodations</strong></a></li>
                        <li><a href="/Owner/Reservations">Reservations</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </header>

    <section class="about-banner relative">
        <div class="overlay overlay-bg"></div>
        <div class="container">
            <div class="row d-flex align-items-center justify-content-center">
                <div class="about-content col-lg-12">
                    <h1 class="text-white">My Accommodations</h1>
                </div>
            </div>
        </div>
    </section>

    <section class="section-gap">
        <div class="container">

            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success">@TempData["Message"]</div>
            }

            <div class="mb-4">
                <a href="/Accommodation/Create" class="primary-btn text-uppercase">+ Add new</a>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info">Nemate nijedan smeštaj. <a href="/Accommodation/Create">Dodajte prvi</a>.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Location</th>
                                <th>Price/night</th>
                                <th>Amenities</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var acc in Model)
                            {
                                var imgUrl = acc.ImageUrls?.FirstOrDefault() ?? "/img/hotels/d1.jpg";
                                <tr>
                                    <td><img src="@imgUrl" style="width:80px;height:60px;object-fit:cover;" /></td>
                                    <td><a href="/Accommodation/Details/@acc.Id">@acc.Name</a></td>
                                    <td>@acc.Location</td>
                                    <td>$@acc.PricePerNight</td>
                                    <td>@string.Join(", ", acc.Amenities ?? new())</td>
                                    <td>
                                        <a href="/Accommodation/Edit/@acc.Id" class="btn btn-sm btn-warning mb-1">Edit</a>
                                        <form asp-controller="Accommodation" asp-action="Delete" method="post" style="display:inline;"
                                              onsubmit="return confirm('Obrisati smeštaj @acc.Name? Sve rezervacije će biti obrisane.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@acc.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <script src="~/js/vendor/jquery-2.2.4.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/vendor/bootstrap.min.js"></script>
</body>
</html>
