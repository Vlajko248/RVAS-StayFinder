			<script>
				document.addEventListener("DOMContentLoaded", function () {
					const reserveForm = document.getElementById("reserveForm");
					if (!reserveForm) return;

					reserveForm.addEventListener("submit", function (e) {
						const start = document.getElementById("searchStart")?.value?.trim();
						const end = document.getElementById("searchReturn")?.value?.trim();

						if (!start || !end) {
							e.preventDefault();
							alert("Unesi start i end datum za rezervaciju.");
							return;
						}

						const confirmed = confirm("Da li ste sigurni da zelite da rezervisete ovaj smestaj?");
						if (!confirmed) {
							e.preventDefault();
						}
					});
				});
