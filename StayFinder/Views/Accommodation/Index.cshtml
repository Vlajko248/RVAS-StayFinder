@model IEnumerable<StayFinder.Models.Accommodation>

@{
    Layout = null;
    ViewData["Title"] = "Hotels";

    var currentUserId = Context.Session.GetString("UserId");
    var currentRole = Context.Session.GetString("Role");
}

<!DOCTYPE html>
<html lang="zxx" class="no-js">
<head>
    <!-- Mobile Specific Meta -->
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <!-- Favicon-->
    @* <link rel="shortcut icon" href="~/img/fav.png"> *@
    <!-- Author Meta -->
    <meta name="author" content="colorlib">
    <!-- Meta Description -->
    <meta name="description" content="">
    <!-- Meta Keyword -->
    <meta name="keywords" content="">
    <!-- meta character set -->
    <meta charset="UTF-8">
    <!-- Site Title -->
    <title>Travel</title>

    <link href="https://fonts.googleapis.com/css?family=Poppins:100,200,400,300,500,600,700" rel="stylesheet">
    <!--
    CSS
    ============================================= -->
    <link rel="stylesheet" href="~/css/linearicons.css">
    <link rel="stylesheet" href="~/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/css/bootstrap.css">
    <link rel="stylesheet" href="~/css/magnific-popup.css">
    <link rel="stylesheet" href="~/css/jquery-ui.css">
    <link rel="stylesheet" href="~/css/nice-select.css">
    <link rel="stylesheet" href="~/css/animate.min.css">
    <link rel="stylesheet" href="~/css/owl.carousel.css">
    <link rel="stylesheet" href="~/css/main.css">
</head>
<body>
    <header id="header">
        <div class="header-top">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6 col-sm-6 col-6 header-top-left">
                        <ul>
                            @if (string.IsNullOrWhiteSpace(currentUserId))
                            {
                                <li><a href="/Account/Login">Log in</a></li>
                                <li><a href="/Account/Register">Sign up</a></li>
                            }
                            else
                            {
                                <li><span style="color:white;">@currentRole</span></li>
                                <li>
                                    <form method="post" action="/Account/Logout" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" style="background:none;border:none;color:white;cursor:pointer;padding:0;">Sign out</button>
                                    </form>
                                </li>
                            }
                        </ul>			
			  			</div>
			  			<div class="col-lg-6 col-sm-6 col-6 header-top-right">
							<div class="header-social">
								<a href="#"><i class="fa fa-facebook"></i></a>
								<a href="#"><i class="fa fa-twitter"></i></a>
								<a href="#"><i class="fa fa-dribbble"></i></a>
								<a href="#"><i class="fa fa-behance"></i></a>
							</div>
			  			</div>
			  		</div>			  					
					</div>
				</div>
				<div class="container main-menu">
					<div class="row align-items-center justify-content-between d-flex">
				      <div id="logo">
						<a href="/" style="font-size:24px;font-weight:700;color:#fff;text-decoration:none;">StayFinder</a>
				      </div>
				      <nav id="nav-menu-container">
						<ul class="nav-menu">
					  <li><a href="/">Home</a></li>
					  <li class="active"><a href="/Accommodation">Hotels</a></li>
					</ul>
				      </nav><!-- #nav-menu-container -->					      		  
					</div>
				</div>
			</header><!-- #header -->
			  
			<!-- start banner Area -->
			<section class="about-banner relative">
				<div class="overlay overlay-bg"></div>
				<div class="container">				
					<div class="row d-flex align-items-center justify-content-center">
						<div class="about-content col-lg-12">
							<h1 class="text-white">
								Hotels				
							</h1>	
							<p class="text-white link-nav"><a href="/">Home </a>  <span class="lnr lnr-arrow-right"></span>  <a href="/Accommodation"> Hotels</a></p>
						</div>	
					</div>
				</div>
			</section>
			<!-- End banner Area -->	

			<!-- Start destinations Area -->
			<section class="destinations-area section-gap">
				<div class="container">
		            <div class="row d-flex justify-content-center">
		                <div class="menu-content pb-40 col-lg-8">
		                    <div class="title text-center">
		                        <h1 class="mb-10">Search Destinations</h1>
		                        <p>We all live in an age that belongs to the young at heart. Life that is becoming extremely fast, day to.</p>
		                    </div>
		                </div>
		            </div>		


                    <!-- start banner Area -->
                    <div class="col-lg-4 col-md-6 banner-right" style="padding: 0; margin-bottom: 30px;">
                        <ul class="nav nav-tabs justify-content-center" id="myTab" role="tablist">
                            <li class="nav-item w-100 text-center">
                            <a class="nav-link active" style="border: none;" id="hotel-tab" data-toggle="tab" href="#hotel" role="tab" aria-controls="hotel" aria-selected="false">Search your next destination!</a>
                            </li>
                        </ul>
                        <div class="tab-content" id="myTabContent">
                            <div class="tab-pane fade  show active" id="hotel" role="tabpanel" aria-labelledby="hotel-tab">
								@{
									var location = Context.Request.Query["location"].ToString();
									var start = Context.Request.Query["start"].ToString();
									var end = Context.Request.Query["end"].ToString();
								}
                            <form class="form-wrap" method="get" action="/Accommodation">
                                <input type="text"
									id="searchLocation"
									class="form-control"
									name="location"
									placeholder="Where?"
									value="@location">

								<input type="text"
									id="searchStart"
									class="form-control date-picker"
									name="start"
									placeholder="Start"
									value="@start">

								<input type="text"
									id="searchReturn"
									class="form-control date-picker"
									name="end"
									placeholder="Return"
									value="@end">

								

                                @* <input type="number" min="1" max="20" class="form-control" name="adults" placeholder="Adults " onfocus="this.placeholder = ''" onblur="this.placeholder = 'Adults '"> *@
                                @* <input type="number" min="1" max="20" class="form-control" name="child" placeholder="Child " onfocus="this.placeholder = ''" onblur="this.placeholder = 'Child '">						 *@
                                <button type="submit" class="primary-btn text-uppercase w-100">Search Hotels</button>


								<div class="amenities-filter">
									<h5 style="margin-bottom: 10px; margin-top: 40px;">Filter by amenities</h5>

									<label>
										<input type="checkbox" class="amenity-filter" value="wifi">
										Wi-fi
									</label>

									<label>
										<input type="checkbox" class="amenity-filter" value="air-condition">
										Air Condition
									</label>

									<label>
										<input type="checkbox" class="amenity-filter" value="swimming-pool">
										Swimming pool
									</label>

									<label>
										<input type="checkbox" class="amenity-filter" value="restaurant">
										Restaurant
									</label>
								</div>									
                            </form>							  	
                            </div>
                        </div>
                    </div>
			<!-- End banner Area -->


						<div class="row">
							@foreach (var hotel in Model)
							{
								var imageUrl = hotel.ImageUrls != null && hotel.ImageUrls.Any()
									? hotel.ImageUrls.First()
									: "/img/hotels/d1.jpg";

								var detailUrl = $"/Accommodation/Details/{hotel.Id}?start={Uri.EscapeDataString(start ?? string.Empty)}&end={Uri.EscapeDataString(end ?? string.Empty)}";

								var amenities = hotel.Amenities != null
									? string.Join(" ", hotel.Amenities.Select(a => a.ToLower()
										.Replace(" ", "-")
										.Replace("wi-fi", "wifi")
										.Replace("wifi", "wifi")
										.Replace("klima", "air-condition")))
									: "";

											<div class="col-lg-4 hotel-card" data-amenities="@amenities">
												<div class="single-destinations">
													<div class="thumb">
														<img src="@imageUrl" alt="@hotel.Name">
													</div>

													<div class="details">
														<h4 class="d-flex justify-content-between">
															<a href="@detailUrl" class="hotel-details-link">
																@hotel.Name
															</a>
															

															<div class="star">
																<span class="fa fa-star checked"></span>
																<span class="fa fa-star checked"></span>
																<span class="fa fa-star checked"></span>
																<span class="fa fa-star checked"></span>
																<span class="fa fa-star"></span>
															</div>
														</h4>

														<p>@hotel.Location</p>

														<ul class="package-list">
															<li class="d-flex justify-content-between align-items-center">
																<span>Swimming pool</span>
																<span>@(hotel.Amenities != null && hotel.Amenities.Contains("Swimming pool") ? "Yes" : "No")</span>
															</li>

															<li class="d-flex justify-content-between align-items-center">
																<span>Wi-fi</span>
																<span>@(hotel.Amenities != null && (hotel.Amenities.Contains("WiFi") || hotel.Amenities.Contains("Wi-fi")) ? "Yes" : "No")</span>
															</li>

															<li class="d-flex justify-content-between align-items-center">
																<span>Air Condition</span>
																<span>@(hotel.Amenities != null && (hotel.Amenities.Contains("Klima") || hotel.Amenities.Contains("Air Condition")) ? "Yes" : "No")</span>
															</li>

															<li class="d-flex justify-content-between align-items-center">
																<span>Restaurant</span>
																<span>@(hotel.Amenities != null && hotel.Amenities.Contains("Restaurant") ? "Yes" : "No")</span>
															</li>

															<li class="d-flex justify-content-between align-items-center">
																<span>Price per night</span>
																<a href="@detailUrl" class="price-btn">
																	$@hotel.PricePerNight
																</a>
															</li>
														</ul>
													</div>
												</div>
											</div>
							}
						</div>	
			</section>
			<!-- End destinations Area -->
			

			<!-- Start home-about Area -->
			<section class="home-about-area">
				<div class="container-fluid">
					<div class="row align-items-center justify-content-end">
						<div class="col-lg-6 col-md-12 home-about-left">
							<h1>
								Did not find your Package? <br>
								Feel free to ask us. <br>
								We‘ll make it for you
							</h1>
							<p>
								inappropriate behavior is often laughed off as “boys will be boys,” women face higher conduct standards especially in the workplace. That’s why it’s crucial that, as women, our behavior on the job is beyond reproach. inappropriate behavior is often laughed.
							</p>
							<a href="#" class="primary-btn text-uppercase">request custom price</a>
