@model StayFinder.Models.Accommodation

@{
    Layout = null;
    ViewData["Title"] = "Add Accommodation";
    var currentRole = Context.Session.GetString("Role");
    var currentFullName = Context.Session.GetString("FullName");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Add Accommodation</title>
    <link href="https://fonts.googleapis.com/css?family=Poppins:100,200,400,300,500,600,700" rel="stylesheet">
    <link rel="stylesheet" href="~/css/linearicons.css">
    <link rel="stylesheet" href="~/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/css/bootstrap.css">
    <link rel="stylesheet" href="~/css/main.css">
</head>
<body>
    <header id="header">
        <div class="header-top">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6 col-sm-6 col-6 header-top-left">
                        <ul>
                            <li><span style="color:white;">@currentRole — @currentFullName</span></li>
                            <li>
                                <form method="post" action="/Account/Logout" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" style="background:none;border:none;color:white;cursor:pointer;padding:0;">Sign out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="container main-menu">
            <div class="row align-items-center justify-content-between d-flex">
                <div id="logo">
                    <a href="/" style="font-size:24px;font-weight:700;color:#fff;text-decoration:none;">StayFinder</a>
                </div>
                <nav id="nav-menu-container">
                    <ul class="nav-menu">
                        <li><a href="/">Home</a></li>
                        <li><a href="/Owner/Dashboard">Dashboard</a></li>
                        <li><a href="/Accommodation/MyAccommodations">My Accommodations</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </header>

    <section class="about-banner relative">
        <div class="overlay overlay-bg"></div>
        <div class="container">
            <div class="row d-flex align-items-center justify-content-center">
                <div class="about-content col-lg-12">
                    <h1 class="text-white">Add Accommodation</h1>
                </div>
            </div>
        </div>
    </section>

    <section class="section-gap">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-7">
                    <div style="padding:30px; background:#f9f9ff; border-radius:8px;">

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger" asp-validation-summary="All"></div>
                        }

                        <form method="post" asp-controller="Accommodation" asp-action="Create"
                              enctype="multipart/form-data">
                            @Html.AntiForgeryToken()

                            <div class="form-group mb-3">
                                <label>Name *</label>
                                <input asp-for="Name" class="form-control" required />
                            </div>

                            <div class="form-group mb-3">
                                <label>Location *</label>
                                <input asp-for="Location" class="form-control" required />
                            </div>

                            <div class="form-group mb-3">
                                <label>Description</label>
                                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            </div>

                            <div class="form-group mb-3">
                                <label>Price per night ($) *</label>
                                <input asp-for="PricePerNight" type="number" min="1" step="0.01" class="form-control" required />
                            </div>

                            <div class="form-group mb-3">
                                <label class="d-block mb-2">Amenities</label>
                                @{
                                    var amenityOptions = new[] { "WiFi", "Air Condition", "Swimming pool", "Restaurant", "Parking", "Kitchen", "TV", "Gym" };
                                }
                                <div class="row">
                                    @foreach (var amenity in amenityOptions)
                                    {
                                        <div class="col-6 col-md-4 mb-2">
                                            <div class="form-check">
                                                <input class="form-check-input amenity-cb" type="checkbox" value="@amenity" id="amenity_@amenity.Replace(" ", "_")">
                                                <label class="form-check-label" for="amenity_@amenity.Replace(" ", "_")">@amenity</label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="form-group mb-3">
                                <label>Images (možeš odabrati više)</label>
                                <input type="file" name="imageFiles" id="imageFilesInput" class="form-control" accept="image/*" multiple />
                                <small class="text-muted">Prva slika biće primarna, ali možeš promeniti ispod.</small>
                            </div>

                            <div id="imagePreviewContainer" class="mb-3" style="display:none;">
                                <label class="d-block mb-2">Odaberi primarnu sliku <small class="text-muted">(klikni na sliku)</small></label>
                                <div id="imagePreviews" class="d-flex flex-wrap gap-2"></div>
                                <input type="hidden" name="primaryIndex" id="primaryIndex" value="0" />
                            </div>

                            <button type="submit" class="primary-btn text-uppercase">Save</button>
                            <a href="/Accommodation/MyAccommodations" class="btn btn-link ml-2">Cancel</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script src="~/js/vendor/jquery-2.2.4.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/vendor/bootstrap.min.js"></script>
    <script>
        // Checkboxes -> hidden Amenities inputi pre submit-a
        document.querySelector("form").addEventListener("submit", function () {
            const checked = document.querySelectorAll(".amenity-cb:checked");
            checked.forEach(function (cb, i) {
                const input = document.createElement("input");
                input.type = "hidden";
                input.name = `Amenities[${i}]`;
                input.value = cb.value;
                document.querySelector("form").appendChild(input);
            });
        });

        // Preview vise slika + odabir primarne
        const fileInput = document.getElementById("imageFilesInput");
        const previewContainer = document.getElementById("imagePreviewContainer");
        const previews = document.getElementById("imagePreviews");
        const primaryIndexInput = document.getElementById("primaryIndex");

        fileInput.addEventListener("change", function () {
            previews.innerHTML = "";
            if (!fileInput.files || fileInput.files.length === 0) {
                previewContainer.style.display = "none";
                return;
            }
            previewContainer.style.display = "block";
            primaryIndexInput.value = "0";

            Array.from(fileInput.files).forEach(function (file, idx) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const wrapper = document.createElement("div");
                    wrapper.style.cssText = "cursor:pointer; position:relative; margin:4px;";
                    wrapper.dataset.index = idx;

                    const img = document.createElement("img");
                    img.src = e.target.result;
                    img.style.cssText = "width:100px; height:80px; object-fit:cover; border-radius:4px; border:3px solid transparent;";
                    if (idx === 0) img.style.border = "3px solid #f8b739";

                    const badge = document.createElement("span");
                    badge.textContent = "Primary";
                    badge.style.cssText = "display:" + (idx === 0 ? "block" : "none") + "; position:absolute; bottom:6px; left:0; right:0; text-align:center; background:rgba(248,183,57,0.9); color:#fff; font-size:11px; padding:1px 0;";

                    wrapper.appendChild(img);
                    wrapper.appendChild(badge);
                    previews.appendChild(wrapper);

                    wrapper.addEventListener("click", function () {
                        // Ukloni highlight sa svih
                        previews.querySelectorAll("img").forEach(i => i.style.border = "3px solid transparent");
                        previews.querySelectorAll("span").forEach(s => s.style.display = "none");
                        // Postavi na kliknutu
                        img.style.border = "3px solid #f8b739";
                        badge.style.display = "block";
                        primaryIndexInput.value = idx;
                    });
                };
                reader.readAsDataURL(file);
            });
        });
    </script>
    </script>
</body>
</html>
